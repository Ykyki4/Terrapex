	}

	SunwingBow: {
		DisplayName: Sunwing Bow
		Tooltip:
			'''
			Turns Wooden Arrows into Scarab Arrows
			Scarab Arrows bounce off the first wall they hit
			'''
	}

	SunScepter: {
		DisplayName: Sun Scepter
		Tooltip:
			'''
			Lobs a sun bolt
			Where it lands, a pillar of sand bursts out of the ground
			'''
	}

	BeetlingStaff: {
		DisplayName: Beetling Staff
		Tooltip:
			'''
			Summons a gilded beetling to fight for you
			It lines up on a target and dives straight through it
			'''
	}

	KhepriScythe: {
		DisplayName: Khepri's Scythe
		Tooltip:
			'''
			After each strike, a sun pebble drops out of it and rolls on
			An edge strike drops two, one each way
			'''
	}

	Glacierbreaker: {
		DisplayName: Glacierbreaker
		Tooltip:
			'''
			Frostburns what it hits
			The first blow of each swing knocks three ice splinters off the head
			'''
	}

	HoarfrostBow: {
		DisplayName: Hoarfrost Bow
		Tooltip:
			'''
			Turns wooden arrows into icicles
			Icicles drop after a moment and burst into three splinters where they break
			'''
	}

	SnowcapStaff: {
		DisplayName: Snowcap Staff
		Tooltip:
			'''
			Lobs a snowball that rolls along the ground
			The snowball grows as it rolls, up to nearly twice the size and damage
			'''
	}

	GlacierBell: {
		DisplayName: Glacier Bell
		Tooltip:
			'''
			Summons a rime-spirit to fight for you
			Its darting strikes frostburn
			'''
	}

	FrostfellScythe: {
		DisplayName: Frostfell Scythe
		Tooltip:
			'''
			After each strike an icicle drops onto the point - three on the edge
			The Reap brings a row of six icicles down around you
			'''
	}

	PermafrostHeart: {
		DisplayName: Permafrost Heart
		Tooltip:
			'''
			Standing still for a second grows a shell of frost over you
			The shell takes 30% off the next hit and bursts into six ice splinters
			Immunity to Chilled and Frozen
			'''
	}

