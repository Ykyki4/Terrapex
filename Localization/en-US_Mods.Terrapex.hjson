	}

	FirstKeeperTrophy: {
		DisplayName: First Keeper Trophy
		Tooltip: ""
	}

	FirstKeeperBag: {
		DisplayName: Treasure Bag
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	FacetCarapace: {
		DisplayName: Facet Carapace
		Tooltip:
			'''
			4 defense
			15% increased mining speed
			'''
	}

	# ---------------------------------------------------------------- the Breach event
	Ejecta: {
		DisplayName: Ejecta
		Tooltip: Rock from the far side of the crack, thrown up when it opened
	}

	BreachFlare: {
		DisplayName: Breach Flare
		Tooltip:
			'''
			Opens a Breach where you are standing
			Underground only — the crack has to come from somewhere
			'''
	}

	Slabmaul: {
		DisplayName: Slabmaul
		Tooltip:
			'''
			Swing at the ground and a plate of it comes up where you aimed
			Swing at a plate that is standing and it breaks toward your cursor
			Raise the wall, then throw it at whatever is flying
			'''
	}

	Overburden: {
		DisplayName: Overburden
		Tooltip:
			'''
			1 defense for every 2 enemies near you, up to 12
			Worth nothing in a fight you were going to win
			'''
	}

	SoundingRod: {
		DisplayName: Sounding Rod
		Tooltip: Breach mouths show through stone, and the way to them is marked
	}
}

SetBonus: {
	TidewrackSet:
		'''
		Strikes in the edge band of your reach bank a swell, up to {0}
		A Reap breaks them: a wave runs along the floor each way to the rim of your reach, {1}% of weapon damage per swell
		'''
	SunwroughtSet:
		'''
		While your Harvest is full, every strike rolls a sun out of the point it hit for {0}% of its damage
		Its path is drawn from your reticle, and it gathers {1}% damage for each enemy it rolls through
		'''
	FirstReaper: Enemies inside your reach take 18% more damage from you: while you hold a scythe, the reach is your regard
	WeaverReaper: Your hits plant anchors and the loom strings a thread between them; it takes an anchor on every hit
	DarnerReaper: Stitched enemies take 20% more damage from you, and your strikes on them land as if on the edge
	Scarecrow: Harvest fills {0}% faster and holds twice as long before it drains
	Ronin: Iaido: stand without attacking for {0} seconds and your next stroke strikes with the edge on everything it touches
	Fissurite: Every {0}th hit cracks the target, taking {1}% more damage for 3 seconds
	Dustseeker: Ore and creatures both show through stone, and you deal 8% more ranged damage
	Glassblower: Broken glass gathers around you, and magic damage is increased by 10%
	Riftsteel: Three plates orbit you, each eating one enemy shot; the shell returns 8 seconds after it breaks
	DarnerMelee: Stitched enemies take 20% more damage from you, and your melee strikes on them always crit
	DarnerRanged: Stitched enemies take 20% more damage from you, and your shots ride the thread to the other end
	DarnerMagic: Stitched enemies take 20% more damage from you
	DarnerSummon: Stitched enemies take 20% more damage from you, and 25% more again from your minions
	WeaverMelee: Your hits plant anchors and the loom strings a thread between them; it weaves on every second hit and its threads cut half again as hard
	WeaverRanged: Your hits plant anchors and the loom strings a thread between them; its threads stand twice as long
	WeaverMagic: Your hits plant anchors and the loom strings a thread between them; it holds three, and weaves a triangle
	WeaverSummon: Your hits plant anchors and the loom strings a thread between them; your minions work the loom for you
	FirstMelee: Enemies you are looking at take 36% more damage from you; the melee stare is narrow and heavy
	FirstRanged: Enemies you are looking at take 18% more damage from you, and your regard reaches twice as far
	FirstMagic: Enemies inside the circle at your cursor take 18% more damage from you
	FirstSummon: Enemies you are looking at take 18% more damage from you, and 18% more again from your minions, which always go for what you are watching
}

