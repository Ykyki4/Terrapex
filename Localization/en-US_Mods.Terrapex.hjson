# This file will automatically update with entries for new content after a build and reload.
# Please read https://github.com/tModLoader/tModLoader/wiki/Localization to learn more about localization and these files.

Items: {
	HarvestMoon: {
		DisplayName: Harvest Moon
		Tooltip:
			'''
			Each cut ends in the next of four rites: tide, sun, frost, fire
			A whirlpool, a rolling sun pebble, a falling icicle, a burning crescent
			The moon over your reach shows which comes next
			Reap: all four at once where you aim
			'''
	}

	Eclipse: {
		DisplayName: Eclipse
		Tooltip:
			'''
			Each cut ends in the next of five rites: tide, sun, frost, fire, rift
			A cut on the edge gives two rites at once, under a corona
			Every hit burns with hellfire
			Reap: all five at once where you aim
			'''
	}

	LongNight: {
		DisplayName: Long Night
		Tooltip:
			'''
			Five rites in turn, two on the edge
			Reap: all five at once, the Death Sickle's three sickles, and three seconds of night
			Through the night your reach goes dark and every cut inside it lands on the edge
			'''
	}

	EventHorizon: {
		DisplayName: Event Horizon
		Tooltip:
			'''
			Five rites in turn, two on the edge, and the Long Night on a Reap
			Every cut opens a vortex on its point that drags small enemies to its core
			The vortex collapses into all five rites at once
			'''
	}

	Almanac: {
		DisplayName: Almanac
		Tooltip:
			'''
			Casts the page it is open at: Tide, Sun, Snow or Scree
			Tide blows a bursting brine bubble, Sun lobs a bolt that raises a pillar of sand,
			Snow rolls a growing snowball, Scree throws a cone of stones
			The book turns its own page every 4 casts
			'Four tomes, one binding'
			'''
	}

	EquinoxAlmanac: {
		DisplayName: Equinox Almanac
		Tooltip:
			'''
			Casts the page it is open at: Tide, Sun, Snow or Scree
			Right-click to turn the page
			Hold to charge: when the ring closes, the page casts its greater form
			and a lance of the Riftflow runs down your aim
			'''
	}

	Solstice: {
		DisplayName: Solstice
		Tooltip:
			'''
			Every cast is the chosen page and the page opposite it
			Right-click to turn the page
			Hold to charge: both pages cast their greater forms, a Riftflow lance fires
			and a strand of the Loom is strung across the cursor
			'''
	}

	Cosmogony: {
		DisplayName: Cosmogony
		Tooltip:
			'''
			The four pages stand around you
			Each cast shuts the book, and every page throws its own spell at the cursor
			Right-click chooses a page; the chosen page is lit and hits harder
			Hold to charge: all four greater forms, the lance, the strand,
			and the Regard opens on the cursor
			'Before the world, the book'
			'''
	}

	MenagerieHorn: {
		DisplayName: Menagerie Horn
		Tooltip:
			'''
			Summons a beast of the menagerie to fight for you
			Each summon is the next beast: crab, beetling, rime sprite, hatchling
			The crab walks and grips its prey, the beetling dives, the sprite rams and chills, the hatchling spits
			'''
	}

	WildCourt: {
		DisplayName: Wild Court
		Tooltip:
			'''
			Summons a beast of the court to fight for you
			Each summon is the next beast: crab, beetling, rime sprite, hatchling
			While all four beasts are out, the court is in session: 15% increased summon damage
			'''
	}

	GroveConclave: {
		DisplayName: Grove Conclave
		Tooltip:
			'''
			Summons a beast of the conclave to fight for you
			Each summon is the next beast; all four out is 15% increased summon damage
			Every 6 seconds the beasts trade places and each strikes its own target at once
			'''
	}

	TheArk: {
		DisplayName: The Ark
		Tooltip:
			'''
			Summons the whole ark: all four beasts in one minion slot
			The court is always in session: 15% increased summon damage
			Every 6 seconds the beasts trade places and strike at once
			Every 3 seconds each beast fires a volley
			'''
	}

	Wayfinder: {
		DisplayName: Wayfinder
		Tooltip:
			'''
			Wooden arrows leave it as the four winds in turn:
			spray bursts into three, sun glances off walls,
			frost drops an icicle where it breaks, the cleft goes through
			'''
	}

	CompassRose: {
		DisplayName: Compass Rose
		Tooltip:
			'''
			Wooden arrows leave it as the four winds in turn
			Every fourth shot looses all four winds at once in a fan
			The fan's arrows leave the Rib's mark on what they hit
			'''
	}

	TradeWind: {
		DisplayName: Trade Wind
		Tooltip:
			'''
			The four winds in turn, and every fourth shot all four in a fan
			Each shot looses a lighter second arrow of the opposite wind
			Arrows that fly 25 tiles catch the trade wind: they stop falling and hit 40% harder
			A tailwind arrow threads its first hit on to the next enemy
			'''
	}

	Horizon: {
		DisplayName: Horizon
		Tooltip:
			'''
			The four winds, the fan, the second arrow and the trade wind
			Every eighth shot a rose of eight bows opens above you
			and each looses its own arrow at the cursor in turn
			before the eye at its centre lays one stare down the same line
			'''
	}

	Confluence: {
		DisplayName: Confluence
		Tooltip:
			'''
			Each swing carries the next current: tide, sun, frost, bone
			Tide shoves and soaks, sun burns and flares, frost sheds splinters, bone cracks and throws a ricocheting splinter
			Every third swing lets a wave of the current go
			'''
	}

	TrueConfluence: {
		DisplayName: True Confluence
		Tooltip:
			'''
			Each swing carries the next current: tide, sun, frost, bone
			Every swing lets a wave of the current go
			Every fourth swing throws all four currents at once, in a fan
			'''
	}

	Worldseam: {
		DisplayName: Worldseam
		Tooltip:
			'''
			Each swing carries the next current and lets its wave go; every fourth throws all four
			Where a wave lands it leaves a seam in the air
			The seam snaps shut half a second later and strikes along its line
			'''
	}

	Meridian: {
		DisplayName: Meridian
		Tooltip:
			'''
			Currents, waves, the fan of four and the seams they leave
			Every swing opens the five blades of the tree around you
			Each copy strikes through the cursor and lets go of its own sword's trick
			'''
	}

	TidewrackHood: {
		DisplayName: Tidewrack Hood
		Tooltip:
			'''
			{0}% increased reaping critical strike chance
			Harvest fills {1}% faster
			'''
	}

	TidewrackCoat: {
		DisplayName: Tidewrack Coat
		Tooltip:
			'''
			{0}% increased reaping damage
			{1}% more of the blade counts as edge
			'''
	}

	TidewrackBoots: {
		DisplayName: Tidewrack Boots
		Tooltip:
			'''
			{0}% increased reaping speed
			{1}% increased movement speed
			'''
	}

	SunwroughtNemes: {
		DisplayName: Sunwrought Nemes
		Tooltip:
			'''
			{0}% increased reaping critical strike chance
			Scythe reach is {1}% wider
			'''
	}

	SunwroughtCarapace: {
		DisplayName: Sunwrought Carapace
		Tooltip:
			'''
			{0}% increased reaping damage
			Reaps deal {1}% more damage
			'''
	}

	SunwroughtGreaves: {
		DisplayName: Sunwrought Greaves
		Tooltip:
			'''
			{0}% increased reaping speed
			Harvest holds {1}% longer before it drains
			'''
	}

	BarnacledHone: {
		DisplayName: Barnacled Hone
		Tooltip:
			'''
			Critical blade hits crust a barnacle on the target, up to {0}
			A strike at range knocks them all off: {1}% more damage and extra Harvest for each
			'''
	}

	ScarabAmulet: {
		DisplayName: Scarab Amulet
		Tooltip:
			'''
			After a Reap the sun rises for {0} seconds:
			scythe reach is {1}% wider and {2}% more of the blade counts as edge
			'''
	}

	RimeboundWrap: {
		DisplayName: Rimebound Wrap
		Tooltip:
			'''
			Hits with the haft throw the target back hard and frostbite it
			The next edge or strike hit on a frostbitten target shatters the frost for {0}% more damage
			'''
	}

	TidewalkerSandals: {
		DisplayName: Tidewalker Sandals
		Tooltip:
			'''
			Grants the ability to swim
			Allows walking on water
			25% increased movement speed in water
			'''
	}

	SandstriderWraps: {
		DisplayName: Sandstrider Wraps
		Tooltip:
			'''
			Faster acceleration on sand, immunity to desert winds
			10% increased movement speed in the desert
			Running kicks up sand that confuses enemies behind you
			'''
	}

	RimetreadBoots: {
		DisplayName: Rimetread Boots
		Tooltip:
			'''
			Provides extra mobility on ice
			Faster acceleration on snow and ice
			'''
	}

	WayfarersBoots: {
		DisplayName: Wayfarer's Boots
		Tooltip:
			'''
			The wearer can run super fast
			20% increased movement speed, 10% more in the desert and 25% more in water
			Allows swimming and walking on water, extra mobility on ice
			Running kicks up sand that confuses enemies behind you
			Immunity to Slow and desert winds
			'''
	}

	RiftstrideBoots: {
		DisplayName: Riftstride Boots
		Tooltip:
			'''
			Allows flight and super fast running
			20% increased movement speed, 10% more in the desert and 25% more in water
			Allows swimming and walking on water, extra mobility on ice
			Running kicks up sand that confuses enemies behind you
			Immunity to Slow and desert winds
			Landing from a great height throws nearby enemies back
			'''
	}

	ThreadstepBoots: {
		DisplayName: Threadstep Boots
		Tooltip:
			'''
			Allows flight and running up to 7.5
			30% increased movement speed, 10% more in the desert and 25% more in water
			Allows swimming and walking on water and lava, extra mobility on ice
			Immunity to lava, fire blocks, Slow and desert winds
			Running kicks up sand that confuses enemies behind you
			Landing from a great height throws nearby enemies back
			Run off a ledge and a thread holds you level for one second
			'''
	}

	WorldwalkerBoots: {
		DisplayName: Worldwalker Boots
		Tooltip:
			'''
			Allows Terraspark flight and running up to 8.5
			38% increased movement speed, 10% more in the desert and 25% more in water
			Allows swimming and walking on water and lava, extra mobility on ice
			Immunity to lava, fire blocks, Slow and desert winds
			Running kicks up sand that confuses enemies behind you
			Landing from a great height throws nearby enemies back
			Run off a ledge and a thread holds you level for one second
			'''
	}

	GullFeather: {
		DisplayName: Gull Feather
		Tooltip: Double tap a direction for a light dash
	}

	SquallAegis: {
		DisplayName: Squall Aegis
		Tooltip:
			'''
			Double tap a direction to dash into an enemy
			The dash pushes a gust ahead that throws enemies back
			Grants immunity to knockback and fire blocks
			'''
	}

	RiftAegis: {
		DisplayName: Rift Aegis
		Tooltip:
			'''
			Double tap a direction to dash through enemies, hitting all of them
			You are briefly invulnerable at the end of the dash
			The dash still pushes a gust ahead
			Immunity to knockback and fire blocks
			Puts a shell around you when below 50% life
			'''
	}

	WeaversAegis: {
		DisplayName: Weaver's Aegis
		Tooltip:
			'''
			Double tap a direction to dash through enemies, hitting all of them
			You are briefly invulnerable at the end of the dash, and the dash pushes a gust ahead
			Each dash leaves a damaging thread along its path for 2 seconds
			Immunity to knockback and fire blocks
			Puts a shell around you when below 50% life
			Absorbs 25% of damage done to players on your team while above 25% life
			Allows the ability to climb walls and a chance to dodge attacks
			'''
	}

	RegardAegis: {
		DisplayName: Regard Aegis
		Tooltip:
			'''
			Press the Regard Dash key to dash toward the cursor, through enemies, hitting all of them
			Without the key bound, double tap a direction instead
			You are briefly invulnerable at the end of the dash, and the dash pushes a gust ahead
			Each dash leaves a damaging thread along its path for 2 seconds
			For one second after the dash, enemies it passed through take 30% more damage from you
			Immunity to knockback and fire blocks
			Puts a shell around you when below 50% life
			Absorbs 25% of damage done to players on your team while above 25% life
			Allows the ability to climb walls and a chance to dodge attacks
			'''
	}

	SunIdol: {
		DisplayName: Sun Idol
		Tooltip:
			'''
			Summons the Scarab Sultan
			Use during the day in the surface desert
			'''
