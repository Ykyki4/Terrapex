	// ---------------------------------------------------------------- reaper class (CLASS_REAPER.md)
	
	RustedSickle: {
		DisplayName: Rusted Sickle
		Tooltip: A field tool, held by someone who has stopped farming
	}

	FissuriteScythe: {
