	GlassReaper: {
		DisplayName: Glass Reaper
		Tooltip: Reap: throws three glass crescents that shatter where they fall
	}

	Kusarigama: {
		DisplayName: Kusarigama
		Tooltip:
			'''
			A sickle on a chain
			After a strike, the sickle is hauled back on its chain from the point, cutting on the way
			Reap: throws the blade, hooks the first enemy it bites and drags it into reach
			'''
	}

	FrostbiteSickle: {
		DisplayName: Frostbite Sickle
		Tooltip:
			'''
			After a strike, three icicles burst out of the point, sticking in and shattering
			Edge hits burn with frost
			Reap: a ring of icicles
			'''
	}

	Gravedigger: {
		DisplayName: Gravedigger
		Tooltip:
			'''
			After a strike, a soul climbs out of the point and hunts the nearest enemy
